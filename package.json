{
  "name": "cs498-cicd-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Mock Node.js app for CS498 CI/CD demo",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
